# Root Environment Configuration Template for Qore Monorepo

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qore_db?schema=public"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXTAUTH_SECRET="super-secret-nextauth-encryption-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Backend
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="super-secret-jwt-signing-key-min-32-chars"

# OpenRouter AI (gpt-4o-mini / custom models)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_UPSELL_MODEL="openai/gpt-4o-mini"

# Stripe Billing & Payments
STRIPE_SECRET_KEY="sk_test_51xxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
STRIPE_PRO_PRICE_ID="price_xxxxxxxxxxxx"
STRIPE_BUSINESS_PRICE_ID="price_xxxxxxxxxxxx"

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# SMTP Mailer (Optional)
SMTP_HOST="smtp.example.com"
SMTP_USER="notifications@example.com"
SMTP_PASS="password"
