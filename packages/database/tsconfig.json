{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2021",
        "lib": ["ES2021"],
        "declaration": true,
        "outDir": "./dist",
        "rootDir": "./",
        "moduleResolution": "Node16",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "resolveJsonModule": true,
        "ignoreDeprecations": "6.0"
    },
    "include": ["index.ts"],
    "exclude": ["node_modules", "dist"]
}
