generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  free
  pro
  business
}

enum OrderStatus {
  new
  preparing
  ready
  delivered
  cancelled
}

enum ReservationStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum FeedbackStatus {
  published // Видно всім
  flagged // Містить підозрілі слова, чекає модерації власника
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  name     String?
  image    String?

  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  subscriptionPlan      SubscriptionPlan @default(free)
  subscriptionExpiresAt DateTime?
  stripeSubscriptionId  String?          @unique

  activeThemeId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  activeTheme    TenantTheme?    @relation("ActiveTheme", fields: [activeThemeId], references: [id])
  settings       TenantSettings?
  tables         Table[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  reservations   Reservation[]
  menuViews      MenuView[]
  themes         TenantTheme[]
  orders         Order[]
  happyHourRules HappyHourRule[]
  feedbacks      Feedback[]
}

model TenantSettings {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  // Профіль закладу
  description   String?
  logoUrl       String?
  coverUrl      String?
  phone         String?
  address       String?
  instagramUrl  String?
  googleMapsUrl String?

  // Сервіси та Графік
  workingHours Json
  wifiSsid     String?
  wifiPassword String?

  // Бронювання
  reservationStepMinutes  Int @default(30)
  minReservationTime      Int @default(30)
  maxGuestsPerReservation Int @default(12)

  kdsToken String? @unique
  kdsPin   String?
}

model Table {
  id       String  @id @default(cuid())
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  capacity Int
  qrToken  String  @unique @default(cuid())
  isActive Boolean @default(true)

  orders       Order[]
  cartSessions CartSession[]

  @@unique([tenantId, name])
}

model MenuCategory {
  id        String     @id @default(cuid())
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  icon      String?
  color     String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]

  happyHourRules HappyHourRule[]
}

model MenuItem {
  id             String       @id @default(cuid())
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  tenantId       String
  category       MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId     String
  name           String
  description    String?
  price          Decimal
  happyHourPrice Decimal?
  imageUrl       String?
  allergens      Json?
  tags           Json?
  isActive       Boolean      @default(true) // ручний "86 list" тумблер
  sortOrder      Int          @default(0)

  orderItems     OrderItem[]
  cartItems      CartItem[]
  happyHourRules HappyHourRule[]
}

model Reservation {
  id          String            @id @default(cuid())
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  tenantId    String
  tableId     String?
  guestName   String
  guestPhone  String
  guestsCount Int
  reservedAt  DateTime
  status      ReservationStatus @default(pending)
  notes       String?
  createdAt   DateTime          @default(now())
}

model MenuView {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  tableId   String?
  viewedAt  DateTime @default(now())
  userAgent String?
}

// Тема оформлення (в т.ч. згенерована AI)
model TenantTheme {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  themeConfig   Json
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  activeForTenant Tenant? @relation("ActiveTheme") // зворотний бік Tenant.activeThemeId
}

// Сесія "спільного кошика" для столика
// ------------------------------------------------------
// 🛒 СИСТЕМА СПІЛЬНОГО КОШИКА (Чернетка замовлення)
// ------------------------------------------------------

// Одна сесія кошика = Одне сидіння гостей за столом
model CartSession {
  id              String   @id @default(cuid())
  table           Table?   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId         String?
  isActive        Boolean  @default(true) // true, поки гості замовляють. false - коли закрили рахунок
  isTakeaway      Boolean  @default(false) // true для замовлень "з собою" без прив'язки до столу
  confirmedGuests String[] @default([])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Конкретна страва, яку хтось додав у спільний кошик
model CartItem {
  id            String      @id @default(cuid())
  cartSession   CartSession @relation(fields: [cartSessionId], references: [id], onDelete: Cascade)
  cartSessionId String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  quantity Int @default(1)

  // Ідентифікація того, хто додав страву
  guestSessionId String // Унікальний ID браузера гостя (з Zustand)
  guestName      String // Наприклад: "Максим"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  tenantId      String
  table         Table?        @relation(fields: [tableId], references: [id])
  tableId       String?
  status        OrderStatus   @default(new)
  paymentStatus PaymentStatus @default(pending)
  isOrderAhead  Boolean       @default(false)
  pickupAt      DateTime?
  customerName  String? // ім'я гостя для замовлень "з собою" / order-ahead 
  totalAmount   Decimal

  items OrderItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  feedbacks Feedback[]
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  quantity     Int     @default(1)
  priceAtOrder Decimal // Фіксуємо ціну на момент замовлення (якщо ціна в меню зміниться)

  // Переносимо дані про гостя з CartItem, щоб знати, хто замовив страву у фінальному чеку
  guestSessionId String?
  guestName      String?

  // Для спліт-чеку (Split Bill)
  paidByGuestId      String? // Хто саме оплатив цю позицію
  isLockedForPayment Boolean   @default(false) // Захист від подвійного списання
  lockedAt           DateTime? // Таймер розблокування, якщо оплата зависла
}

model HappyHourRule {
  id            String       @id @default(cuid())
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  name          String // Наприклад: "Friday Cocktails"
  daysOfWeek    Int[] // [1, 2, 3, 4, 5] (0 = Неділя, 6 = Субота)
  startTime     String // "16:00"
  endTime       String // "18:00"
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float // 20 (для 20%) або 50 (для $50 фіксованої знижки)
  isActive      Boolean      @default(true)

  // Нативні зв'язки Prisma (many-to-many)
  categories MenuCategory[]
  items      MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id             String         @id @default(cuid())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?
  rating         Int // 1-5
  comment        String?        @db.Text
  guestName      String?
  aiSummaryBatch String? // ID нічного AI-резюме (Pro)
  status         FeedbackStatus @default(published)
  createdAt      DateTime       @default(now())
}
