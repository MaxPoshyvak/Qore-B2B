generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  free
  pro
  business
}

enum OrderStatus {
  new
  preparing
  ready
  delivered
  cancelled
}

enum ReservationStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  partially_paid
  paid
  failed
}

enum PaymentTransactionStatus {
  pending
  succeeded
  failed
  cancelled
}

enum SplitType {
  full
  equal
  by_item
  custom
}

enum FeedbackStatus {
  published // Видно всім
  flagged // Містить підозрілі слова, чекає модерації власника
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  name     String?
  image    String?

  stripeCustomerId String? @unique

  isEmailVerified      Boolean   @default(false)
  emailVerifyToken     String?   @unique
  emailVerifyOtp       String?
  emailVerifyExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants             Tenant[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique // Унікальний хеш токена
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // Час, коли токен "згорить" (наприклад, через 15 хв)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Tenant {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  subscriptionPlan      SubscriptionPlan @default(free)
  subscriptionExpiresAt DateTime?
  stripeSubscriptionId  String?          @unique
  stripeCustomerId      String?          @unique
  stripePriceId         String?
  subscriptionStatus    String?          @default("active")

  activeThemeId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  activeTheme    TenantTheme?    @relation("ActiveTheme", fields: [activeThemeId], references: [id])
  settings       TenantSettings?
  tables         Table[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  reservations   Reservation[]
  menuViews      MenuView[]
  themes         TenantTheme[]
  orders              Order[]
  paymentTransactions PaymentTransaction[]
  happyHourRules      HappyHourRule[]
  feedbacks           Feedback[]
  feedbackDigest      FeedbackDigest?
}

model TenantSettings {
  id       String @id @default(cuid())
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String @unique

  // Профіль закладу
  description   String?
  logoUrl       String?
  coverUrl      String?
  phone         String?
  address       String?
  instagramUrl  String?
  googleMapsUrl String?

  // Сервіси та Графік
  workingHours Json
  wifiSsid     String?
  wifiPassword String?

  // Бронювання
  reservationStepMinutes  Int @default(30)
  minReservationTime      Int @default(30)
  maxGuestsPerReservation Int @default(12)

  kdsToken String? @unique
  kdsPin   String?
}

model Table {
  id       String  @id @default(cuid())
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  tenantId String
  name     String
  capacity Int
  qrToken  String  @unique @default(cuid())
  isActive Boolean @default(true)

  orders       Order[]
  cartSessions CartSession[]

  @@unique([tenantId, name])
}

model MenuCategory {
  id        String     @id @default(cuid())
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  tenantId  String
  name      String
  icon      String?
  color     String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]

  happyHourRules HappyHourRule[]
}

model MenuItem {
  id             String       @id @default(cuid())
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  tenantId       String
  category       MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId     String
  name           String
  description    String?
  price          Decimal
  happyHourPrice Decimal?
  imageUrl       String?
  allergens      Json?
  tags           Json?
  isActive       Boolean      @default(true) // ручний "86 list" тумблер
  sortOrder      Int          @default(0)

  orderItems     OrderItem[]
  cartItems      CartItem[]
  happyHourRules HappyHourRule[]
  modifiers      ModifierGroup[]
}

/// Група модифікаторів страви (напр. "Choice of Milk", "Extra Toppings").
/// `minSelections`/`maxSelections` описують правила вибору для гостя:
/// min=0 — група необов'язкова, max=1 — радіо-вибір, max>1 — мультивибір.
model ModifierGroup {
  id            String   @id @default(cuid())
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId    String
  name          String
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  sortOrder     Int      @default(0)

  options ModifierOption[]

  @@index([menuItemId])
}

/// Конкретна опція всередині групи модифікаторів.
/// `priceAdjustment` — дельта до базової ціни страви (може бути від'ємною,
/// напр. -0.50 за відмову від інгредієнта), тому Decimal без обмеження знаку.
model ModifierOption {
  id              String        @id @default(cuid())
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId         String
  name            String
  priceAdjustment Decimal       @default(0)
  sortOrder       Int           @default(0)

  @@index([groupId])
}

model Reservation {
  id          String            @id @default(cuid())
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  tenantId    String
  tableId     String?
  guestName   String
  guestPhone  String
  guestsCount Int
  reservedAt  DateTime
  status      ReservationStatus @default(pending)
  notes       String?
  createdAt   DateTime          @default(now())
}

model MenuView {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  tableId   String?
  viewedAt  DateTime @default(now())
  userAgent String?
}

// Тема оформлення (в т.ч. згенерована AI)
model TenantTheme {
  id            String   @id @default(cuid())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  tenantId      String
  themeConfig   Json
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  activeForTenant Tenant? @relation("ActiveTheme") // зворотний бік Tenant.activeThemeId
}

// Сесія "спільного кошика" для столика
// ------------------------------------------------------
// 🛒 СИСТЕМА СПІЛЬНОГО КОШИКА (Чернетка замовлення)
// ------------------------------------------------------

// Одна сесія кошика = Одне сидіння гостей за столом
model CartSession {
  id              String   @id @default(cuid())
  table           Table?   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId         String?
  isActive        Boolean  @default(true) // true, поки гості замовляють. false - коли закрили рахунок
  isTakeaway      Boolean  @default(false) // true для замовлень "з собою" без прив'язки до столу
  confirmedGuests String[] @default([])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Конкретна страва, яку хтось додав у спільний кошик
model CartItem {
  id            String      @id @default(cuid())
  cartSession   CartSession @relation(fields: [cartSessionId], references: [id], onDelete: Cascade)
  cartSessionId String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  quantity Int @default(1)

  /// Знімок обраних модифікаторів цієї конкретної конфігурації:
  /// `[{ id, name, priceAdjustment }]`. Дві однакові страви з різними
  /// модифікаторами мусять лишатися РІЗНИМИ рядками кошика, тому саме це
  /// поле (а не лише `menuItemId`) визначає, чи можна злити позиції.
  selectedModifiers Json?

  // Ідентифікація того, хто додав страву
  guestSessionId String // Унікальний ID браузера гостя (з Zustand)
  guestName      String // Наприклад: "Максим"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  tenantId      String
  table         Table?        @relation(fields: [tableId], references: [id])
  tableId       String?
  status        OrderStatus   @default(new)
  paymentStatus PaymentStatus @default(pending)
  isOrderAhead  Boolean       @default(false)
  pickupAt      DateTime?
  customerName  String? // ім'я гостя для замовлень "з собою" / order-ahead 
  totalAmount   Decimal
  paidAmount    Decimal       @default(0)
  paymentMethod String?

  items     OrderItem[]
  payments  PaymentTransaction[]
  feedbacks Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  quantity     Int     @default(1)
  priceAtOrder Decimal // Фіксуємо ціну на момент замовлення (якщо ціна в меню зміниться)

  /// Історичний знімок модифікаторів рядка: `[{ id, name, priceAdjustment }]`.
  /// Зберігаємо копію, а не лише зв'язок, щоб старі чеки не «поїхали», якщо
  /// власник згодом перейменує, переоцінить або видалить опцію з меню.
  selectedModifiers Json?

  // Переносимо дані про гостя з CartItem, щоб знати, хто замовив страву у фінальному чеку
  guestSessionId String?
  guestName      String?

  // Для спліт-чеку (Split Bill)
  paidByGuestId        String? // Хто саме оплатив цю позицію
  isLockedForPayment   Boolean             @default(false) // Захист від подвійного списання
  lockedAt             DateTime? // Таймер розблокування, якщо оплата зависла
  lockedBySessionId    String? // Хто саме заблокував цю позицію
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  paymentTransactionId String?
}

model PaymentTransaction {
  id                    String                   @id @default(cuid())
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId               String
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId              String

  guestSessionId        String? // ID гостя (браузера), який здійснив оплату
  guestName             String? // Ім'я гостя для чека

  amount                Decimal // Сума замовлення/страви
  tipAmount             Decimal                  @default(0) // Чайові
  totalCharged          Decimal // amount + tipAmount

  status                PaymentTransactionStatus @default(pending)
  splitType             SplitType                @default(full)
  splitPayerCount       Int?

  stripeSessionId       String?                  @unique
  stripePaymentIntentId String?                  @unique

  paidItems             OrderItem[]

  paidAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([orderId])
  @@index([tenantId])
}

model HappyHourRule {
  id            String       @id @default(cuid())
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  name          String // Наприклад: "Friday Cocktails"
  daysOfWeek    Int[] // [1, 2, 3, 4, 5] (0 = Неділя, 6 = Субота)
  startTime     String // "16:00"
  endTime       String // "18:00"
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float // 20 (для 20%) або 50 (для $50 фіксованої знижки)
  isActive      Boolean      @default(true)

  // Нативні зв'язки Prisma (many-to-many)
  categories MenuCategory[]
  items      MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id             String         @id @default(cuid())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?
  rating         Int // 1-5
  comment        String?        @db.Text
  guestName      String?
  aiSummaryBatch String? // ID нічного AI-резюме (Pro)
  status         FeedbackStatus @default(published)
  createdAt      DateTime       @default(now())
}

model FeedbackDigest {
  id               String   @id @default(cuid())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String   @unique
  contentHash      String
  summary          String   @db.Text
  overallSentiment String
  sentimentScore   Int
  topics           Json
  strengths        String[]
  improvements     String[]
  actionableTip    String   @db.Text
  reviewCount      Int
  averageRating    Float
  analyzedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, contentHash])
}
